{
  "name": "resourcepackbuilder",
  "private": true,
  "version": "1.4.0",
  "description": "Turns Blockbench models (.bbmodel), Java models (JSON + PNG) or textures into ready-to-use Nexo items including a resource pack (external pack). Next.js UI in an Electron shell.",
  "author": {
    "name": "Kyloschmeilo"
  },
  "homepage": "https://github.com/SLNE-Development/ResourcepackBuilder",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:electron",
    "build:electron": "node electron/build.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc -p electron",
    "app": "npm run build && electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "icon": "node scripts/make-icon.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@resourcepackbuilder/config": "*",
    "@resourcepackbuilder/core": "*",
    "@resourcepackbuilder/desktop-contract": "*",
    "@resourcepackbuilder/i18n": "*",
    "@resourcepackbuilder/minecraft": "*",
    "@resourcepackbuilder/preview": "*",
    "@resourcepackbuilder/test-utils": "*",
    "@resourcepackbuilder/ui": "*",
    "@resourcepackbuilder/utils": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "cn": "^0.4.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "next": "^16.4.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
