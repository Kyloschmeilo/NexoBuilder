{
  "name": "resourcepackbuilder",
  "private": true,
  "version": "1.4.0",
  "description": "Erstellt aus Blockbench-Modellen (.bbmodel), Java-Modellen (JSON + PNG) oder Texturen fertige Nexo-Items inklusive Resourcepack (external pack).",
  "author": {
    "name": "Kyloschmeilo"
  },
  "homepage": "https://github.com/SLNE-Development/ResourcepackBuilder",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "app": "next build && electron .",
    "dist:win": "next build && electron-builder --win --x64 --publish never",
    "icon": "node scripts/make-icon.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@resourcepackbuilder/config": "*",
    "@resourcepackbuilder/core": "*",
    "@resourcepackbuilder/i18n": "*",
    "@resourcepackbuilder/preview": "*",
    "@resourcepackbuilder/ui": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.52.0",
    "next": "^16.4.1",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "next-intl": "^4.14.9"
  }
}
