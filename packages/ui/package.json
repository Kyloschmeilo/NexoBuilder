{
  "name": "@resourcepackbuilder/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable React building blocks: shadcn/ui components (Base UI), shared generic components and the app theme (Tailwind, fonts).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.tsx",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.8.0",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@resourcepackbuilder/config": "*"
  }
}
