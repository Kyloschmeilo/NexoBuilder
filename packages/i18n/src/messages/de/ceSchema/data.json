      "field": {
        "label": "Lied",
        "placeholder": "namespace:lied"
      }
    },
    "dataExternal": {
      "label": "External",
      "description": "Übernimmt die Daten eines Items aus einem anderen Plugin.",
      "field": {
        "label": "Extern",
        "fields": {
          "plugin": {
            "label": "Plugin",
            "placeholder": "z.B. mmoitems"
