          "id": {
            "label": "Item-ID",
            "placeholder": "example_item"
          }
        }
      }
    },
    "dataComponents": {
      "label": "Components",
      "description": "Rohe Vanilla-Datenkomponenten. CraftEngine prüft sie nicht über Versionen hinweg.",
      "field": {
        "label": "Komponenten",
        "keyLabel": "Komponente",
        "value": {
          "label": "Wert (YAML)"
        },
        "keyPlaceholder": "z.B. minecraft:tool"
      }
    },
    "dataRemoveComponents": {
      "label": "Remove Components",
      "description": "Entfernt diese Komponenten vom Item.",
      "field": {
        "label": "Komponenten",
        "placeholder": "minecraft:attribute_modifiers"
      }
    },
    "clientBoundData": {
      "label": "Client Bound Data",
      "description": "Item-Daten, die nur an Spieler gesendet und für jeden einzeln aufgelöst werden, etwa bedingte Namen und Lore.",
      "field": {
        "label": "Daten (YAML)",
        "placeholder": "lore: …"
      },
      "hint": "Nimmt dieselben Schlüssel wie data. Für Daten, die von Bedingungen abhängen, conditional#name-Einträge verwenden."
    }
