{
  "name": "@resourcepackbuilder/test-server",
  "private": true,
  "version": "0.0.0",
  "description": "The local test server's rules: config and limits, console commands, server log parsing, status, Java and plugin versions, the files synced into the plugin folder; one ServerAdapter per pack target (Nexo, CraftEngine).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "verify:plugins": "node verify/run.mjs"
  },
  "dependencies": {
    "@resourcepackbuilder/core": "*",
    "@resourcepackbuilder/export": "*",
    "@resourcepackbuilder/minecraft": "*",
    "@resourcepackbuilder/utils": "*",
    "jszip": "^3.10.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resourcepackbuilder/config": "*",
    "@resourcepackbuilder/test-utils": "*",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3"
  }
}
