{
  "name": "resourcepackbuilder-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=resourcepackbuilder",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "app": "npm run app -w resourcepackbuilder",
    "dist:win": "turbo run dist:win",
    "icon": "npm run icon -w resourcepackbuilder"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@11.19.0"
}
